# ==============================================================================
# File: 01_ingestion_and_fields.spl
# Purpose: Verify data ingestion into index=cybersecurity_lab, inspect sample
#          events, audit schema/field extraction, and check ingestion lag.
# Dataset: normalised_events.jsonl (sourcetype="_json", 8 synthetic events)
# ==============================================================================

# 1. Full index scan (start with All time on lab data to confirm event timestamps)
index=cybersecurity_lab

# 2. Scoped ingestion check matching source, host, index, and sourcetype
source="normalised_events.jsonl" host="parrot" index="cybersecurity_lab" sourcetype="_json"

# 3. Quick single-event verification using head
index=cybersecurity_lab
| head 1

# 4. Field extraction and schema summary across the first 5 events
index=cybersecurity_lab
| head 5
| fieldsummary

# 5. Event time (_time) vs. ingestion time (_indextime) lag audit
index=cybersecurity_lab
| eval index_time=_indextime, lag_seconds=_indextime - _time
| table _time index_time lag_seconds event.action
