# ==============================================================================
# File: 03_timecharts_and_audit.spl
# Purpose: Analyze event volume over time, authentication failure trends,
#          and time-bounded slices for investigation and dashboarding.
# ==============================================================================

# 1. Overall event volume over time (timechart)
index=cybersecurity_lab sourcetype="_json"
| timechart count

# 2. Authentication failures over time (timechart)
index=cybersecurity_lab sourcetype="_json" event.outcome="failure"
| timechart count AS auth_failures

# 3. Event actions split over time (timechart by event.action)
index=cybersecurity_lab sourcetype="_json"
| timechart count by event.action

# 4. Example time-bounded search (adjust earliest/latest to target window)
index=cybersecurity_lab sourcetype="_json" earliest=11/06/2026:08:00:00 latest=11/06/2026:08:15:00
| stats count by event.action
| sort - count

# 5. Deduplicated event.action list to inspect distinct action types cleanly
index=cybersecurity_lab sourcetype="_json"
| dedup event.action
| table event.action
